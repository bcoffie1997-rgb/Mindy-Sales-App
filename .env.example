# GovCon Sales Dashboard — Environment Secrets
# Copy this file to .env and fill in your credentials.

# Application and serverless API
APP_ORIGIN=http://localhost:3002
API_SECRET=replace-with-a-long-random-value
DASHBOARD_PASSWORD=replace-with-a-strong-password
AGENT_WORKER_URL=
AGENT_WORKER_SECRET=

# Optional: migrate through the protected deployed API instead of using a
# local Supabase service-role key.
# MIGRATION_API_URL=https://mindy-sales-app.vercel.app

# Supabase (service role key must only be used server-side)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (required for Revenue page; STRIPE_API_KEY remains a legacy fallback)
STRIPE_SECRET_KEY=sk_live_...
# STRIPE_API_KEY=sk_live_...

# Slack (required for agent notifications)
SLACK_BOT_TOKEN=xoxb-...

# Gmail — OAuth2 method (recommended for workspace)
GMAIL_CLIENT_ID=...
GMAIL_CLIENT_SECRET=...
GMAIL_REFRESH_TOKEN=...
# OR service account method
GMAIL_SERVICE_ACCOUNT_JSON=/path/to/service-account.json

# Google Calendar (uses same Gmail credentials)
GOOGLE_CALENDAR_ID=primary


# Fireflies (required for post-call transcript processing)
FIREFLIES_API_KEY=...

# OpenAI (optional, for LLM-powered agent actions)
OPENAI_API_KEY=...
