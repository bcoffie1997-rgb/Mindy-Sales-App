# GovCon Sales Dashboard — Environment Secrets
# Copy this file to .env and fill in your credentials.

# Stripe (required for Revenue page)
STRIPE_API_KEY=sk_live_...

# Slack (required for agent notifications)
SLACK_BOT_TOKEN=xoxb-...

# Gmail — OAuth2 method (recommended for workspace)
GMAIL_CLIENT_ID=...
GMAIL_CLIENT_SECRET=...
GMAIL_REFRESH_TOKEN=...
# OR service account method
GMAIL_SERVICE_ACCOUNT_JSON=/path/to/service-account.json

# Google Calendar (uses same Gmail credentials)
GOOGLE_CALENDAR_ID=primary


# Fireflies (required for post-call transcript processing)
FIREFLIES_API_KEY=...

# OpenAI (optional, for LLM-powered agent actions)
OPENAI_API_KEY=...
